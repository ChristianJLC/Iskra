# Cadena de conexión de PostgreSQL (Neon). En Neon, copia la "Connection string" (usa el modo "pooled" para runtime).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Clave secreta para firmar las sesiones (JWT). Genera una con: openssl rand -base64 32
SESSION_SECRET="reemplaza-esto-con-una-clave-larga-y-aleatoria"

# Clave de la API de Anthropic (Claude) para estimar nutrición a partir de fotos de comida.
# Consíguela en https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY="sk-ant-..."

# Opcional: modelo de Claude para calcular el plan de nutrición (una sola vez por usuario). Por defecto claude-sonnet-5.
ANTHROPIC_MODEL="claude-sonnet-5"

# Opcional: modelo de Claude para analizar fotos de comida (debe soportar visión, hasta 4 veces al día por usuario).
# Por defecto claude-haiku-4-5-20251001 (más barato, alcanza para esta tarea).
ANTHROPIC_PHOTO_MODEL="claude-haiku-4-5-20251001"

# Clave de la API de Resend, usada para avisarte por correo cuando alguien se registra (con el código de verificación).
# Consíguela en https://resend.com/api-keys
RESEND_API_KEY="re_..."

# Correo donde te llegan los avisos de nuevos registros con el código de verificación.
ADMIN_EMAIL="christianjlc10@gmail.com"



// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())

  meals              MealEntry[]
  studies            StudyEntry[]
  tasks              Task[]
  financeSettings    FinanceSettings[]
  financeEntries     FinanceEntry[]
  recurringBills     RecurringBill[]
  workoutSchedule    WorkoutSchedule?
  workoutCompletions WorkoutCompletion[]
}

enum MealType {
  DESAYUNO
  ALMUERZO
  CENA
}

model MealEntry {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date        DateTime @default(now())
  type        MealType
  description String
  notes       String?
  calories    Int?
  proteinG    Float?
  carbsG      Float?
  fatG        Float?
  completed   Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([userId, date])
}

enum RoutineGroup {
  DESCANSO
  PECHO_BICEPS
  ESPALDA_TRICEPS
  PIERNAS_ABDOMINALES
  BOMBEO
}

model WorkoutSchedule {
  id        String       @id @default(cuid())
  userId    String       @unique
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  monday    RoutineGroup @default(DESCANSO)
  tuesday   RoutineGroup @default(DESCANSO)
  wednesday RoutineGroup @default(DESCANSO)
  thursday  RoutineGroup @default(DESCANSO)
  friday    RoutineGroup @default(DESCANSO)
  saturday  RoutineGroup @default(DESCANSO)
  sunday    RoutineGroup @default(DESCANSO)
  updatedAt DateTime     @updatedAt
}

model WorkoutCompletion {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime
  group     RoutineGroup
  createdAt DateTime     @default(now())

  @@unique([userId, date])
  @@index([userId, date])
}

model StudyEntry {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date          DateTime @default(now())
  subject       String
  targetMinutes Int
  actualMinutes Int      @default(0)
  completed     Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([userId, date])
}

enum TaskPriority {
  BAJA
  MEDIA
  ALTA
}

model Task {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  dueDate     DateTime?
  priority    TaskPriority @default(MEDIA)
  completed   Boolean      @default(false)
  createdAt   DateTime     @default(now())

  @@index([userId, completed])
}

model FinanceSettings {
  id             String  @id @default(cuid())
  userId         String
  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  month          Int
  year           Int
  biweeklyIncome Decimal @db.Decimal(12, 2)

  @@unique([userId, month, year])
}

enum FinanceType {
  INGRESO
  EXTRA
  GASTO
}

model FinanceEntry {
  id              String         @id @default(cuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  date            DateTime       @default(now())
  type            FinanceType
  amount          Decimal        @db.Decimal(12, 2)
  description     String?
  recurringBillId String?
  recurringBill   RecurringBill? @relation(fields: [recurringBillId], references: [id], onDelete: SetNull)
  createdAt       DateTime       @default(now())

  @@index([userId, date])
}

model RecurringBill {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  amount      Decimal      @db.Decimal(12, 2)
  priority    TaskPriority @default(MEDIA)
  startDay    Int
  endDay      Int?
  createdAt   DateTime     @default(now())

  payments FinanceEntry[]

  @@index([userId])
}

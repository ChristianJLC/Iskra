// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  accentColor  String?
  accentColor2 String?
  avatarId     String?
  timezone     String   @default("America/Lima")
  lastSeenAnnouncement String?

  meals              MealEntry[]
  savedMeals         SavedMeal[]
  mealPhotoAnalyses  MealPhotoAnalysis[]
  studies            StudyEntry[]
  studySubjects      StudySubject[]
  tasks              Task[]
  financeSettings    FinanceSettings[]
  financeEntries     FinanceEntry[]
  recurringBills     RecurringBill[]
  workoutSchedule    WorkoutSchedule?
  workoutCompletions WorkoutCompletion[]
  nutritionProfile   NutritionProfile?
  waterEntries       WaterEntry[]
  savedIngredients   SavedIngredient[]
}

model PendingSignup {
  id                       String   @id @default(cuid())
  email                    String   @unique
  name                     String
  passwordHash             String
  verificationCode         String
  verificationCodeAttempts Int      @default(0)
  createdAt                DateTime @default(now())
}

model SavedIngredient {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key       String
  name      String
  calories  Int
  proteinG  Float
  carbsG    Float
  fatG      Float
  portion   String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([userId, key])
  @@index([userId, updatedAt])
}

enum MealType {
  DESAYUNO
  ALMUERZO
  CENA
  SNACK
}

model MealEntry {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date        DateTime @default(now())
  type        MealType
  description String
  notes       String?
  calories    Int?
  proteinG    Float?
  carbsG      Float?
  fatG        Float?
  ingredients Json?
  completed   Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([userId, date])
}

model SavedMeal {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  calories    Int?
  proteinG    Float?
  carbsG      Float?
  fatG        Float?
  ingredients Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, title])
  @@index([userId, updatedAt])
}

model WaterEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime
  glasses   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
}

model MealPhotoAnalysis {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

enum MuscleGroup {
  PECHO
  ESPALDA
  BICEPS
  TRICEPS
  HOMBROS
  PIERNAS
  ABDOMINALES
  GLUTEOS
  CARDIO
  BOMBEO
}

model WorkoutSchedule {
  id        String        @id @default(cuid())
  userId    String        @unique
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  monday    MuscleGroup[] @default([])
  tuesday   MuscleGroup[] @default([])
  wednesday MuscleGroup[] @default([])
  thursday  MuscleGroup[] @default([])
  friday    MuscleGroup[] @default([])
  saturday  MuscleGroup[] @default([])
  sunday    MuscleGroup[] @default([])
  updatedAt DateTime      @updatedAt
}

enum NutritionGoal {
  PERDER_GRASA
  GANAR_MUSCULO
  MANTENER_PESO
}

enum Sex {
  HOMBRE
  MUJER
}

enum ActivityLevel {
  SEDENTARIO
  LIGERAMENTE_ACTIVO
  MODERADAMENTE_ACTIVO
  MUY_ACTIVO
  ATLETA_PROFESIONAL
}

enum DietType {
  RECOMENDADA
  ALTA_PROTEINA
  BAJA_CARBOHIDRATOS
  KETO
  BAJA_GRASAS
}

enum WeightChangeSpeed {
  RECOMENDADO
  RAPIDO
  LENTO
}

model NutritionProfile {
  id               String             @id @default(cuid())
  userId           String             @unique
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal             NutritionGoal?
  sex              Sex?
  age              Int?
  heightCm         Float?
  weightKg         Float?
  activityLevel    ActivityLevel?
  strengthTraining Boolean?
  dietType         DietType?
  targetWeightKg   Float?
  speed            WeightChangeSpeed?
  targetCalories   Int?
  targetCalorieMin Int?
  targetCalorieMax Int?
  targetProteinG   Int?
  targetCarbsG     Int?
  targetFatG       Int?
  completedAt      DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
}

model WorkoutCompletion {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime
  groups    MuscleGroup[]
  createdAt DateTime      @default(now())

  @@unique([userId, date])
  @@index([userId, date])
}

model StudySubject {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  targetMinutes Int
  createdAt     DateTime     @default(now())
  entries       StudyEntry[]

  @@unique([userId, name])
}

model StudyEntry {
  id                 String        @id @default(cuid())
  userId             String
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId          String?
  subject            StudySubject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  subjectName        String
  date               DateTime      @default(now())
  targetMinutes      Int
  accumulatedSeconds Int           @default(0)
  runningSince       DateTime?
  completed          Boolean       @default(false)
  createdAt          DateTime      @default(now())

  @@index([userId, date])
}

enum TaskPriority {
  BAJA
  MEDIA
  ALTA
}

model Task {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  dueDate     DateTime?
  priority    TaskPriority @default(MEDIA)
  completed   Boolean      @default(false)
  createdAt   DateTime     @default(now())

  @@index([userId, completed])
}

enum IncomeFrequency {
  QUINCENAL
  MENSUAL
}

model FinanceSettings {
  id              String          @id @default(cuid())
  userId          String
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  month           Int
  year            Int
  biweeklyIncome  Decimal         @db.Decimal(12, 2)
  incomeFrequency IncomeFrequency @default(QUINCENAL)

  @@unique([userId, month, year])
}

enum FinanceType {
  INGRESO
  EXTRA
  GASTO
}

model FinanceEntry {
  id              String         @id @default(cuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  date            DateTime       @default(now())
  type            FinanceType
  amount          Decimal        @db.Decimal(12, 2)
  description     String?
  recurringBillId String?
  recurringBill   RecurringBill? @relation(fields: [recurringBillId], references: [id], onDelete: SetNull)
  createdAt       DateTime       @default(now())

  @@index([userId, date])
}

model RecurringBill {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  amount      Decimal      @db.Decimal(12, 2)
  priority    TaskPriority @default(MEDIA)
  startDay    Int
  endDay      Int?
  createdAt   DateTime     @default(now())

  payments FinanceEntry[]

  @@index([userId])
}
